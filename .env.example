# IVAO OAuth application credentials (https://developers.ivao.aero)
# Server-side only — never prefix these with NEXT_PUBLIC_.
IVAO_CLIENT_ID=
IVAO_CLIENT_SECRET=

# Optional. Unlocks the authenticated IVAO endpoints (per-airport traffic,
# ATIS). Live traffic works without it via the public whazzup feed.
IVAO_API_KEY=

# Must match the redirect URI registered in the IVAO application.
# Local: http://localhost:3000/api/ivao/callback
IVAO_REDIRECT_URL=

# Optional. AISWEB (DECEA) API pair. Without them the app and the sync scripts
# use the pair AISWEB's own public site ships, which works but is shared.
# Register your own at https://aisweb.decea.mil.br/?i=publicacoes&p=api
AISWEB_API_KEY=
AISWEB_API_PASS=
