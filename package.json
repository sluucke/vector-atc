{
  "name": "vector-atc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Console operacional para controladores da rede IVAO: cartas oficiais do DECEA, procedimentos SID/STAR no mapa, pista em uso, METAR, nível de transição, NOTAM e tráfego ao vivo.",
  "license": "MIT",
  "author": "The Duck Corporation",
  "homepage": "https://vectoratc.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/sluucke/vector-atc.git"
  },
  "bugs": {
    "url": "https://github.com/sluucke/vector-atc/issues"
  },
  "keywords": [
    "ivao",
    "atc",
    "air-traffic-control",
    "decea",
    "aisweb",
    "aeronautical-charts",
    "sid",
    "star",
    "flight-simulation",
    "nextjs"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/check-cruise-levels.ts",
    "sync:airport": "tsx scripts/sync-airport.ts",
    "build:content": "tsx scripts/build-content.ts",
    "sync:rea": "tsx scripts/sync-rea.ts",
    "sync:frequencies": "tsx scripts/set-network-frequencies.ts",
    "probe:heading": "tsx scripts/probe-heading-reference.ts",
    "sync:pdf-worker": "node -e \"require('fs').copyFileSync(require.resolve('pdfjs-dist/build/pdf.worker.min.mjs'),'public/pdf.worker.min.mjs')\"",
    "predev": "npm run sync:pdf-worker",
    "prebuild": "npm run sync:pdf-worker"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
